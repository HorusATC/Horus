{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "sh -c 'if [ -f ./scripts/prepare-hooks.sh ]; then sh ./scripts/prepare-hooks.sh; else echo \"[prepare] skip git hooks (prepare-hooks.sh not in this install context)\"; fi'",
    "dev": "next dev -p 3333",
    "dev:clean": "rm -rf .next && next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir app --dir components --dir utility --dir context --dir types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "tailwind:check": "sh scripts/check-tailwind-content.sh",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001669",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}

{
  "extends": [
    "next/core-web-vitals",
    "next/typescript",
    "plugin:@typescript-eslint/recommended-type-checked-only"
  ],
  "parserOptions": {
    "project": true,
    "projectService": true,
    "tsconfigRootDir": "."
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "@typescript-eslint/unbound-method": "off"
      }
    },
    {
      "files": ["app/api/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.name='proxyToBackend'] > Identifier.arguments:first-child",
            "message": "proxyToBackend must be called with a string or template literal path at the call site, not a variable"
          },
          {
            "selector": "CallExpression[callee.name='fetch'][arguments.0.type='TemplateLiteral']:has(Identifier[name='BACKEND_BASE_URL'])",
            "message": "Direct fetch with BACKEND_BASE_URL is forbidden in app/api/**. Use proxyToBackend instead."
          },
          {
            "selector": "CallExpression[callee.name='fetch'][arguments.0.type='BinaryExpression']:has(Identifier[name='BACKEND_BASE_URL'])",
            "message": "Direct fetch with BACKEND_BASE_URL is forbidden in app/api/**. Use proxyToBackend instead."
          }
        ]
      }
    }
  ]
}
